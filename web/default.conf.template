# Start directly with http-context directives like resolver, map, and upstream.
resolver 127.0.0.11 valid=30s ipv6=off;

# Map Upgrade headers once so we can reuse them
map $http_upgrade $connection_upgrade {
  default   upgrade;
  ""        close;
}

# Sticky-session key built from the Socket.IO cookie
map $http_cookie $socketio_session_id {
    "~io=([^;]+)"  $1;
    default        $remote_addr;  # fallback
}

# Preserve upstream proto (e.g., Apache SSL) so we don't downgrade https -> http.
# If no upstream header, fall back to this hop's $scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# ----------  upstreams -------------
upstream next_client  {
  # fallback works even if include is empty at boot
  server ${PROJECT_NAME}-client:3000 max_fails=3 fail_timeout=30s;
  include /etc/nginx/conf.d/generated/next_client.upstream.conf;
}

upstream api_socketio {
  hash $socketio_session_id  consistent;
  # fallback
  server ${PROJECT_NAME}-server:8000 max_fails=3 fail_timeout=30s;
  include /etc/nginx/conf.d/generated/api_socketio.upstream.conf;
}


server {
    listen 80;
    server_name _;

    # Increase timeouts for long-running connections
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Increase buffer sizes for large headers (e.g., cookies, tokens)
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;

    # Specifically for large response headers
    large_client_header_buffers 4 32k;

    # API traffic (prefixed)
    location ^~ /api/ {
        proxy_pass         http://next_client;
        proxy_http_version 1.1;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host  $host;
    }

    # WebSocket traffic (prefixed) - handle this specifically
    location ^~ /socket.io/ {
        proxy_pass         http://api_socketio;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_buffering    off;
        proxy_cache        off;
        
        # WebSocket specific timeouts
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # All other app traffic (handles trailing slash correctly)
    location ~ ^(/.*)?$ {
        proxy_pass         http://next_client;
        proxy_http_version 1.1;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host  $host;
        
        # Add some buffering for better performance
        proxy_buffering    on;
        proxy_buffer_size  4k;
        proxy_buffers      8 4k;
    }
}