{{/* Find this compose project's name by looking at the nginx container */}}
{{ $nginx := first (whereLabel . "com.docker.compose.service" "nginx") }}
{{ $project := index $nginx.Labels "com.docker.compose.project" }}

{{/* Emit all running server replicas for THIS compose project */}}
{{ range $c := whereLabel . "com.docker.compose.service" "server" }}
  {{ if and $c.State.Running (eq (index $c.Labels "com.docker.compose.project") $project) -}}
server {{ $c.Name }}:8000 max_fails=3 fail_timeout=30s;
  {{- end }}
{{ end }}
