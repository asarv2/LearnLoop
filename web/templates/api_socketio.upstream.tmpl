{{/*
  Generates Nginx upstream "server ..." lines for every running replica of the
  compose service named "server" on the same Docker network.

  It looks for containers whose label "com.docker.compose.service" == "server".
*/}}

{{ $servers := where (where .Containers "State.Running" true) "Label" "com.docker.compose.service=server" }}
{{ range $c := $servers }}
server {{ $c.Name }}:8000 max_fails=3 fail_timeout=30s;
{{ end }}
