{{/* dynamic upstream: running client replicas for THIS compose project */}}
{{ $project := .Env.PROJECT_NAME }}
{{ range $c := .Containers }}
  {{ if and $c.State.Running
           (eq (index $c.Labels "com.docker.compose.service") "client")
           (eq (index $c.Labels "com.docker.compose.project") $project) -}}
server {{ $c.Name }}:3000 max_fails=3 fail_timeout=30s;
  {{- end }}
{{ end }}
